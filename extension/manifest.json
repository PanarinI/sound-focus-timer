{
  "manifest_version": 3,
  "name": "Ember — warm focus timer",
  "version": "0.1.0",
  "description": "A focus timer where time is made of sound. Warm entry, steady plateau, a sunrise instead of an alarm. On-device.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["sidePanel", "storage", "offscreen", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {},
  "side_panel": { "default_path": "hearth.html" }
}
